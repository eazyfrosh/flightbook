rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Profiles: each user reads/writes their own; admins can read/write any
    // (admin/users page, and the isAdmin() role lookup above).
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Bookings: owner or admin only. Never publicly listable or gettable —
    // the two public mirrors below exist specifically so unauthenticated
    // flows don't need any access to this collection at all.
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Public mirror for /manage-booking (reference + last name, no sign-in).
    // Document ID is the booking reference — readable by exact ID only,
    // never listable, so it can't be scanned/enumerated.
    match /bookingLookup/{reference} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn();
    }

    // Public mirror for the QR verification page (reference + token).
    // Document ID is `${reference}_${verificationToken}` — a reference
    // alone can never resolve a document here, and this collection is
    // never listable, so no booking is ever exposed without its token.
    match /bookingVerification/{compoundId} {
      allow get: if true;
      allow list: if false;
      allow write: if isSignedIn();
    }

    // Non-sensitive reference/marketing content: publicly readable,
    // admin-managed.
    match /admin_flights/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /airline_overlays/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /discount_codes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
